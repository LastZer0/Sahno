# Browser: only publishable configuration; never place a service key or Merchant ID here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set these separately as server-side Edge Function secrets, not in the browser build:
# SAHNO_APP_ORIGIN=https://your-sahno-domain.example
# ZARINPAL_MERCHANT_ID=... (server secret)
# SUPABASE_SERVICE_ROLE_KEY=... (server secret)
